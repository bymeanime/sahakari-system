// ============================================================
// Sahakari System Management - Nepal Cooperative Banking
// Comprehensive Database Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. ORGANIZATION HIERARCHY
// ============================================================

model Organization {
  id              String   @id @default(cuid())
  name            String
  nameNepali      String?
  code            String   @unique
  registrationNo  String?
  panNo           String?
  address         String?
  district        String?
  province        String?
  wardNo          String?
  municipality    String?
  phone           String?
  email           String?
  website         String?
  logoUrl         String?
  level           String   @default("PRIMARY") // NATIONAL, PROVINCIAL, DISTRICT, PRIMARY, BRANCH
  parentId        String?
  parent          Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children        Organization[] @relation("OrgHierarchy")
  fiscalYear      String?  // Current fiscal year e.g. "2081/82"
  establishedDate String?
  isActive        Boolean  @default(true)

  // Relations
  members         Member[]
  branches        Branch[]
  employees       Employee[]
  accounts        Account[]
  savingsProducts SavingsProduct[]
  loanProducts    LoanProduct[]
  assets          Asset[]
  inventoryItems  InventoryItem[]
  meetings        Meeting[]
  shareProducts   ShareProduct[]
  users           User[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Branch {
  id             String   @id @default(cuid())
  name           String
  code           String
  address        String?
  district       String?
  phone          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  managerId      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members        Member[]
  employees      Employee[]
  users          User[]
}

// ============================================================
// 2. USERS & AUTHENTICATION
// ============================================================

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  nameNepali     String?
  phone          String?
  avatarUrl      String?
  role           String   @default("STAFF") // SUPER_ADMIN, ADMIN, MANAGER, ACCOUNTANT, STAFF, TELLER
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee       Employee?
}

// ============================================================
// 3. MEMBER MANAGEMENT
// ============================================================

model Member {
  id              String   @id @default(cuid())
  memberNo        String   @unique
  firstName       String
  lastName        String
  firstNameNep    String?
  lastNameNep     String?
  fatherName      String?
  grandfatherName String?
  dateOfBirth     String?
  gender          String?  // MALE, FEMALE, OTHER
  citizenshipNo   String?
  citizenshipDist String?
  panNo           String?
  photoUrl        String?
  phone           String?
  email           String?
  occupation       String?
  annualIncome    Float?
  permanentAddr   String?
  temporaryAddr   String?
  province        String?
  district        String?
  municipality    String?
  wardNo          String?
  tole            String?

  // Membership details
  membershipDate  String?
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, RESIGNED, DECEASED, SUSPENDED
  memberType      String   @default("REGULAR") // REGULAR, ASSOCIATE, HONORARY
  nomineeName     String?
  nomineeRelation String?
  nomineeCitNo    String?

  // Organization & Branch
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  branchId        String?
  branch          Branch?     @relation(fields: [branchId], references: [id])
  introducedBy    String?     // Member who introduced

  // Relations
  savingsAccounts SavingsAccount[]
  loanApplications LoanApplication[]
  shareHoldings   ShareHolding[]
  guarantorOf     LoanApplication[] @relation("Guarantor")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// 4. SAVINGS & DEPOSITS
// ============================================================

model SavingsProduct {
  id              String   @id @default(cuid())
  name            String
  nameNepali      String?
  code            String
  description     String?
  interestRate    Float    @default(0)
  minBalance      Float    @default(0)
  minOpeningAmt   Float    @default(0)
  withdrawalLimit Float?
  lockInPeriod    Int?     // in months
  compoundingFreq String   @default("QUARTERLY") // MONTHLY, QUARTERLY, HALF_YEARLY, YEARLY
  isDefault       Boolean  @default(false)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts        SavingsAccount[]
}

model SavingsAccount {
  id              String   @id @default(cuid())
  accountNo       String   @unique
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id])
  productId       String
  product         SavingsProduct @relation(fields: [productId], references: [id])
  balance         Float    @default(0)
  interestEarned  Float    @default(0)
  lastInterestDate String?
  status          String   @default("ACTIVE") // ACTIVE, CLOSED, DORMANT, FROZEN
  openedDate      String
  closedDate      String?
  nominiName      String?
  nominiRelation  String?

  transactions    SavingsTransaction[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SavingsTransaction {
  id              String   @id @default(cuid())
  accountNo       String
  account         SavingsAccount @relation(fields: [accountNo], references: [accountNo])
  type            String   // DEPOSIT, WITHDRAWAL, INTEREST, FEE
  amount          Float
  balanceAfter    Float
  description     String?
  referenceNo     String?
  transactionDate String
  processedBy     String?
  createdAt       DateTime @default(now())
}

// ============================================================
// 5. LOAN MANAGEMENT
// ============================================================

model LoanProduct {
  id              String   @id @default(cuid())
  name            String
  nameNepali      String?
  code            String
  description     String?
  interestRate    Float
  maxAmount       Float?
  minAmount       Float?
  maxTerm         Int?     // in months
  minTerm         Int?
  repaymentSchedule String? // MONTHLY, QUARTERLY, BULLET
  processingFee   Float    @default(0)
  insuranceRequired Boolean @default(false)
  guarantorRequired Boolean @default(true)
  collateralRequired Boolean @default(false)
  loanType        String   @default("EMI") // EMI, FIXED
  insuranceCharge Float    @default(0)
  serviceCharge   Float    @default(0)
  penaltyRate     Float    @default(0) // % per month
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications    LoanApplication[]
}

model LoanApplication {
  id              String   @id @default(cuid())
  applicationNo   String   @unique
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id])
  productId       String
  product         LoanProduct @relation(fields: [productId], references: [id])
  requestedAmount Float
  approvedAmount  Float?
  term            Int      // in months
  purpose         String?
  purposeNepali   String?
  status          String   @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, DISBURSED, CLOSED, WRITTEN_OFF
  applicationDate String
  approvalDate    String?
  disbursementDate String?
  rejectionReason String?

  // Collateral & Guarantor
  collateralType  String?
  collateralValue Float?
  collateralDesc  String?
  guarantorId     String?
  guarantor       Member?  @relation("Guarantor", fields: [guarantorId], references: [id])

  // Disbursement
  disbursedAmount Float?
  outstandingAmount Float?
  interestRate    Float?
  emiAmount       Float?
  nextDueDate     String?

  // Loan Type & Charges
  loanType        String   @default("EMI") // EMI, FIXED
  processingFee   Float    @default(0)
  insuranceCharge Float    @default(0)
  serviceCharge   Float    @default(0)
  totalCharges    Float    @default(0)
  penaltyRate     Float    @default(0)

  // Review
  reviewedBy      String?
  approvedBy      String?

  repayments      LoanRepayment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LoanRepayment {
  id              String   @id @default(cuid())
  loanId          String
  loan            LoanApplication @relation(fields: [loanId], references: [id])
  installmentNo   Int
  principalAmount Float
  interestAmount  Float
  penaltyAmount   Float  @default(0)
  totalAmount     Float
  paymentDate     String
  status          String @default("PAID") // PAID, PENDING, OVERDUE
  paidDate        String?
  createdAt       DateTime @default(now())
}

// ============================================================
// 6. ACCOUNTING (DOUBLE-ENTRY)
// ============================================================

model Account {
  id              String   @id @default(cuid())
  code            String
  name            String
  nameNepali      String?
  type            String   // ASSET, LIABILITY, INCOME, EXPENSE, EQUITY
  subType         String?  // BANK, CASH, RECEIVABLE, PAYABLE, etc.
  parentId        String?
  parent          Account? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[] @relation("AccountHierarchy")
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  isActive        Boolean  @default(true)
  isSystem        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  journalDebits   JournalEntryItem[] @relation("DebitAccount")
  journalCredits  JournalEntryItem[] @relation("CreditAccount")
}

model JournalEntry {
  id              String   @id @default(cuid())
  voucherNo       String   @unique
  date            String
  narration       String
  narrationNep    String?
  status          String   @default("DRAFT") // DRAFT, POSTED, CANCELLED
  entryType       String   @default("JOURNAL") // JOURNAL, PAYMENT, RECEIPT, CONTRA
  postedBy        String?
  postedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           JournalEntryItem[]
}

model JournalEntryItem {
  id              String   @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId       String
  debitAccount    Account  @relation("DebitAccount", fields: [accountId], references: [id])
  creditAccountId String?
  creditAccount   Account? @relation("CreditAccount", fields: [creditAccountId], references: [id])
  debit           Float    @default(0)
  credit          Float    @default(0)
  description     String?
  createdAt       DateTime @default(now())
}

// ============================================================
// 7. HR & PAYROLL
// ============================================================

model Employee {
  id              String   @id @default(cuid())
  employeeId      String   @unique
  firstName       String
  lastName        String
  firstNameNep    String?
  lastNameNep     String?
  dateOfBirth     String?
  gender          String?
  phone           String?
  email           String?
  address         String?
  citizenshipNo   String?
  photoUrl        String?
  position        String?
  department      String?
  joinDate        String?
  endDate         String?
  salary          Float    @default(0)
  status          String   @default("ACTIVE") // ACTIVE, ON_LEAVE, RESIGNED, TERMINATED
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  branchId        String?
  branch          Branch?     @relation(fields: [branchId], references: [id])
  userId          String?  @unique
  user            User?       @relation(fields: [userId], references: [id])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attendances     Attendance[]
  payrollRecords  PayrollRecord[]
  leaveRequests   LeaveRequest[]
}

// Add missing back-relation on User
// User.employees handled by Employee.userId -> User.id

model Attendance {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  date            String
  checkIn         String?
  checkOut        String?
  status          String   @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LEAVE, HOLIDAY
  remarks         String?
  createdAt       DateTime @default(now())
}

model PayrollRecord {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  month           String   // e.g. "2081-03"
  basicSalary     Float
  allowances      Float    @default(0)
  deductions      Float    @default(0)
  pfDeduction     Float    @default(0)
  citDeduction    Float    @default(0)
  taxDeduction    Float    @default(0)
  netSalary       Float
  status          String   @default("PENDING") // PENDING, PAID, CANCELLED
  paidDate        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LeaveRequest {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  leaveType       String   // ANNUAL, SICK, MATERNITY, PATERNITY, UNPAID
  startDate       String
  endDate         String
  days            Int
  reason          String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// 8. INVENTORY MANAGEMENT
// ============================================================

model InventoryItem {
  id              String   @id @default(cuid())
  name            String
  nameNepali      String?
  code            String   @unique
  category        String?
  unit            String   @default("PCS")
  quantity        Int      @default(0)
  minStockLevel   Int      @default(0)
  unitPrice       Float    @default(0)
  totalValue      Float    @default(0)
  supplier        String?
  location        String?
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    InventoryTransaction[]
}

model InventoryTransaction {
  id              String   @id @default(cuid())
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  type            String   // PURCHASE, SALE, ADJUSTMENT, RETURN
  quantity        Int
  unitPrice       Float
  totalAmount     Float
  referenceNo     String?
  date            String
  description     String?
  createdAt       DateTime @default(now())
}

// ============================================================
// 9. ASSET MANAGEMENT
// ============================================================

model Asset {
  id              String   @id @default(cuid())
  name            String
  nameNepali      String?
  code            String   @unique
  category        String?  // LAND, BUILDING, VEHICLE, FURNITURE, EQUIPMENT, IT
  purchaseDate    String?
  purchasePrice   Float    @default(0)
  currentValue    Float    @default(0)
  depreciationRate Float   @default(0)
  accumulatedDep  Float    @default(0)
  location        String?
  responsiblePerson String?
  status          String   @default("ACTIVE") // ACTIVE, SOLD, DISPOSED, WRITTEN_OFF
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// 10. SHARE MANAGEMENT
// ============================================================

model ShareProduct {
  id              String   @id @default(cuid())
  name            String
  nameNepali      String?
  faceValue       Float
  totalShares     Int
  issuedShares    Int      @default(0)
  availableShares Int
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shareHoldings   ShareHolding[]
}

model ShareHolding {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id])
  productId       String
  product         ShareProduct @relation(fields: [productId], references: [id])
  shareCount      Int
  shareValue      Float
  purchaseDate    String
  certificateNo   String?
  status          String   @default("ACTIVE") // ACTIVE, TRANSFERRED, REDEEMED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// 11. MEETING MANAGEMENT
// ============================================================

model Meeting {
  id              String   @id @default(cuid())
  title           String
  titleNepali     String?
  type            String   // ANNUAL_GENERAL, SPECIAL_GENERAL, BOARD, COMMITTEE, CENTER
  date            String
  time            String?
  venue           String?
  agenda          String?
  minutes         String?
  decisions       String?
  status          String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  attendees       String?  // JSON array of member IDs
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// 12. SYSTEM CONFIGURATION
// ============================================================

model FiscalYear {
  id              String   @id @default(cuid())
  name            String   // e.g. "2081/82"
  startDate       String
  endDate         String
  isActive        Boolean  @default(false)
  isClosed        Boolean  @default(false)
  organizationId  String
  createdAt       DateTime @default(now())
}

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  action          String
  module          String
  recordId        String?
  details         String?
  ipAddress       String?
  createdAt       DateTime @default(now())
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  title           String
  message         String
  type            String   @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  isRead          Boolean  @default(false)
  link            String?
  createdAt       DateTime @default(now())
}
